<?xml version="1.0"?>
<sdf version="1.10">
  <world name="panda_eval_world">

    <gravity>0 0 -9.81</gravity>

    <plugin filename="gz-sim-physics-system"  name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system"  name="gz::sim::systems::Sensors"/>

    <light type="directional" name="sun">
      <cast_shadows>false</cast_shadows>
      <diffuse>1 1 1 1</diffuse>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="ground_link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>10 10</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>10 10</size></plane></geometry>
          <material><diffuse>0.8 0.8 0.8 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="table">
      <static>true</static>
      <pose>0.5 0 0.2 0 0 0</pose>
      <link name="table_link">
        <collision name="collision">
          <geometry><box><size>0.8 0.8 0.4</size></box></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.8 0.8 0.4</size></box></geometry>
          <material><diffuse>0.55 0.4 0.25 1</diffuse></material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
