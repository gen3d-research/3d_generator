new file mode 100644
index 0000000..a686268
--- /dev/null
+++ b/trellis/modules/sparse/conv/torch_submconv.py
@@ -0,0 +1,37 @@
+# Local patch for E12 only: spconv's GPU kernels crash on this GPU (no build for its CUDA), so its
+# same-coordinate 3D convolution is done here in plain torch, with the same weight layout.
+import torch
+import torch.nn as nn
+
+
+class TorchSubMConv3d(nn.Module):
+    """out(p) = sum_k W[k] x(p + k - c) over the kernel, at the input's own coordinates."""
+
+    def __init__(self, in_channels, out_channels, kernel_size, dilation=1, bias=True):
+        super().__init__()
+        self.in_channels, self.out_channels, self.k, self.dilation = in_channels, out_channels, kernel_size, dilation
+        self.weight = nn.Parameter(torch.empty(out_channels, kernel_size, kernel_size, kernel_size, in_channels))
+        self.bias = nn.Parameter(torch.zeros(out_channels)) if bias else None
+
+    def forward(self, x):
+        idx, feats = x.indices.long(), x.features          # idx: batch, d0, d1, d2
+        shape = idx.max(0).values + 1 + 2 * self.k * self.dilation
+        mul = torch.stack([shape[1] * shape[2] * shape[3], shape[2] * shape[3], shape[3], torch.ones_like(shape[3])])
+        key = (idx * mul).sum(1)
+        order = key.argsort()
+        skey = key[order]
+        out = feats.new_zeros(len(feats), self.out_channels)
+        c = (self.k - 1) // 2
+        for a in range(self.k):
+            for b in range(self.k):
+                for d in range(self.k):
+                    off = torch.tensor([0, a - c, b - c, d - c], device=idx.device) * self.dilation
+                    q = ((idx + off) * mul).sum(1)
+                    pos = torch.searchsorted(skey, q).clamp(max=len(skey) - 1)
+                    hit = skey[pos] == q
+                    if hit.any():
+                        src = order[pos[hit]]
+                        out[hit] += feats[src] @ self.weight[:, a, b, d, :].t()
+        if self.bias is not None:
+            out = out + self.bias
+        return x.replace_feature(out)
