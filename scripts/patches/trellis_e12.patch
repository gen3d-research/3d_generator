diff --git a/trellis/modules/sparse/attention/sdpa_varlen.py b/trellis/modules/sparse/attention/sdpa_varlen.py
new file mode 100644
index 0000000..6d35992
--- /dev/null
+++ b/trellis/modules/sparse/attention/sdpa_varlen.py
@@ -0,0 +1,19 @@
+# Local E12 patch, not upstream: attention through torch's scaled_dot_product_attention, for a torch and GPU that
+# neither the installed xformers nor flash_attn has kernels for.
+import torch.nn.functional as F
+
+
+def sdpa_dense(q, k, v):
+    """[B, N, H, C] inputs, as xformers.memory_efficient_attention takes them."""
+    return F.scaled_dot_product_attention(q.transpose(1, 2), k.transpose(1, 2), v.transpose(1, 2)).transpose(1, 2)
+
+
+def sdpa_varlen(q, k, v, q_seqlen, kv_seqlen):
+    """[T, H, C] inputs holding sequences back to back; each query attends only within its own sequence."""
+    out = q.new_empty(q.shape[0], q.shape[1], v.shape[-1])
+    qs = ks = 0
+    for lq, lk in zip(q_seqlen, kv_seqlen):
+        out[qs:qs + lq] = sdpa_dense(q[None, qs:qs + lq], k[None, ks:ks + lk], v[None, ks:ks + lk])[0]
+        qs += lq
+        ks += lk
+    return out
